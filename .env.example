# Never commit real credentials.
NEXTAUTH_URL=http://127.0.0.1:3000
NEXTAUTH_SECRET=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
LASTFM_API_KEY=
# Required for accounts and personal libraries. Vercel's Neon integration
# supplies this server-only variable when the database is attached to the project.
DATABASE_URL=
# For an isolated local database, run npm run db:local and use:
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/postgres?sslmode=disable
