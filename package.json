{
  "name": "musicweb",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src tests scripts next.config.ts --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "node --conditions=react-server --import tsx --test tests/core.test.ts tests/discovery.test.ts",
    "test:integration": "node --import tsx --test tests/integration.test.ts",
    "format:check": "prettier --check src tests scripts next.config.ts",
    "format": "prettier --write src tests scripts next.config.ts",
    "db:setup": "node --conditions=react-server --import tsx scripts/check-db.ts",
    "db:check": "node --conditions=react-server --import tsx scripts/check-db.ts",
    "db:local": "pglite-server --host=127.0.0.1 --db=./data/postgres --port=5433 --max-connections=10"
  },
  "dependencies": {
    "@next/env": "^15.5.29",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-toggle": "^1.1.9",
    "@radix-ui/react-toggle-group": "^1.1.10",
    "@vercel/functions": "^3.11.0",
    "class-variance-authority": "^0.7.1",
    "lucide-react": "^0.525.0",
    "next": "^15.5.29",
    "next-auth": "^4.24.15",
    "pg": "^8.23.1",
    "react": "^19.1.10",
    "react-dom": "^19.1.10",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@electric-sql/pglite-socket": "^0.2.18",
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4.1.11",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/spotify-api": "^0.0.25",
    "autoprefixer": "^10.4.21",
    "eslint": "^9",
    "eslint-config-next": "^15.5.29",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.1.11",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.5"
    },
    "postcss": "$postcss"
  }
}
